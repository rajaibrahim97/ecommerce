# =========================================================================
# Dependency Directories (Never commit these; they are massive and easily re-installed)
# =========================================================================
node_modules/
jspm_packages/
web_modules/

# ========================================================c=================
# Environment Variables & Secrets (CRITICAL: Keeps your API keys safe)
# =========================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
frontend/.env

# =========================================================================
# Production / Build Outputs (Generated automatically during deployment)
# =========================================================================
# Frontend build folders (React/Vite/Next.js)
dist/
build/
.next/
out/

# Backend compilation folders (if using TypeScript or Babel)
lib/
out-tsc/

# =========================================================================
# Logs and Runtime Performance
# =========================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# =========================================================================
# System / OS Files (Specific to your local computer)
# =========================================================================
.DS_Store
Thumbs.db
Desktop.ini

# =========================================================================
# IDEs and Editors (Local editor configurations)
# =========================================================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp